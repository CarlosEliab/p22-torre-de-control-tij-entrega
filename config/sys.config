[
  %% --- configuracion del proyecto 22 (torre de control TIJ) -----------
  {p22_torre_de_control_tij, [
      %% puerto HTTP (API + tablero + WebSocket + metrics)
      {puerto, 8080},
      %% puertas fisicas disponibles para abordar
      {puertas_total, 20},
      %% tope de vuelos vivos simultaneos (la simulacion se mantiene
      %% ligera; el problema habla de 120/dia con picos de 10/hora)
      {max_vuelos_vivos, 14},
      %% caos AUTOMATICO desactivado: no se matan procesos solos.
      %% El caos solo ocurre cuando se pide (boton Caos del tablero
      %% o POST /api/demo/caos); este flag unicamente controla la
      %% inyeccion aleatoria del tick.
      {caos, false},
      %% persistencia del respaldo en disco: sobrevive al reinicio de
      %% la VM/nodo (los vuelos se recuperan al arrancar). En pruebas
      %% no se activa: se usa solo la memoria del proceso.
      {persistir, true},
      {archivo_respaldo, "data/p22_respaldo.bin"},

      %% --- ritmo de la simulacion ------------------------------------
      %% Perfil por defecto: lento (los vuelos no se mueven tan rapido).
      %% Puedes cambiarlo en caliente desde el tablero o la API:
      %%   GET  /api/simulacion
      %%   POST /api/simulacion/ritmo  {"perfil":"normal"}
      %% Perfiles: muy_lento | lento | normal | rapido | personalizado
      {perfil_simulacion, lento},
      %% Los valores de abajo son el respaldo del perfil lento y lo que
      %% se usa cuando el perfil es `personalizado'. La UI y la API los
      %% ajustan en caliente sobre el proceso p22_feed.
      {feed_ms, 15000},               %% tick de la operacion
      {nuevo_vuelo_cada_ms, 90000},   %% alta automatica de vuelos
      {espera_entrada_ms, 60000},     %% 'programado' antes de abordar
      {abordaje_ms, 60000},           %% 'abordando' antes de despegar
      {vuelo_ms, 120000}              %% 'despego' antes de aterrizar
  ]},
  {kernel, [
    {logger_level, info}
  ]}
].
