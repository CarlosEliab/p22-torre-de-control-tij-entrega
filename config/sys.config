[
  %% --- configuracion del proyecto 22 (torre de control TIJ) -----------
  {p22_torre_de_control_tij, [
      %% puerto HTTP (API + tablero + WebSocket + metrics)
      {puerto, 8080},
      %% puertas fisicas disponibles para abordar
      {puertas_total, 20},
      %% periodo del feed simulado (ms); un "tick" de la operacion
      {feed_ms, 2000},
      %% tope de vuelos vivos simultaneos (la simulacion se mantiene
      %% ligera; el problema habla de 120/dia con picos de 10/hora)
      {max_vuelos_vivos, 14},
      %% inyeccion automatica de caos (matar procesos); puedes
      %% desactivarla en la demo con {caos, false} y dispararla a mano
      %% con p22_feed:inyectar_caos().
      {caos, true},
      %% persistencia del respaldo en disco: sobrevive al reinicio de
      %% la VM/nodo (los vuelos se recuperan al arrancar). En pruebas
      %% no se activa: se usa solo la memoria del proceso.
      {persistir, true},
      {archivo_respaldo, "data/p22_respaldo.bin"}
  ]},
  {kernel, [
    {logger_level, info}
  ]}
].
